# Copiá este archivo como .env.local y completá los valores de TU proyecto Supabase
# (Panel → Project Settings → API). Son valores públicos por diseño: la protección real está en RLS.
# NUNCA pongas acá la clave "service_role" ni la contraseña de la base.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon-o-publishable
